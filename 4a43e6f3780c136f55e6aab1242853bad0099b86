      "writtenOn": "2026-07-23T08:18:17Z",
      "side": 1,
      "message": "phosphor-user-manager is responsible for user and group membership management.\nShould it really be the one deciding whether a protocol like IPMI is enabled or disabled on a platform?\nThis feels like it might be outside the scope of what this service owns.",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 44
      },
      "revId": "4a43e6f3780c136f55e6aab1242853bad0099b86",
